# =====================================================================
#  PCHelper — переменные окружения для Docker Compose
#  Скопируй в .env:  cp .env.example .env
#  Файл .env обязателен к добавлению в .gitignore
# =====================================================================

# --- База данных ---
POSTGRES_DB=pchelper
POSTGRES_USER=pchelper
POSTGRES_PASSWORD=pchelper_dev_password
POSTGRES_PORT=5432

# --- Кэш ---
REDIS_PASSWORD=pchelper_redis_password
REDIS_PORT=6379

# --- Порты приложения ---
WEB_PORT=8080
API_PORT=3001
MCP_PORT=8081

# --- Безопасность ---
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change_me_in_production
CORS_ORIGIN=http://localhost:8080

# --- Внешние сервисы ---
SUPABASE_URL=
SUPABASE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- MCP ---
PCHELPER_AGENT_NAME=docker