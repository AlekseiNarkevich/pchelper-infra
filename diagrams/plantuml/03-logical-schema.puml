@startuml 03-logical-schema

' ============================================================================
'  ЛОГИЧЕСКАЯ СХЕМА БАЗЫ ДАННЫХ (соответствует рис. 2 методички)
'  Лабораторная работа № 4, задание 2, пункт 1.
'
'  Отличие от физической модели (диаграмма 04):
'    * используются БИЗНЕС-имена сущностей («Компонент», «Пользователь»),
'      а не технические;
'    * указаны только атрибуты — без типов данных, первичных и внешних
'      ключей и без названий конкретных таблиц.
'  Это промежуточный слой между предметной областью и схемой PostgreSQL.
'
'  Сущности сгруппированы в семь доменов-пакетов.
'  Сущности, перенесённые без изменений из лабораторной работы 3,
'  помечены комментарием «уточнено».
' ============================================================================
title Логическая схема базы данных PCHelper (рис. 2)
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #e8e8e8
  BorderColor #bdbdbd
  ArrowColor #1976d2
  FontColor #212121
}
skinparam package {
  BackgroundColor #fafafa
  BorderColor #bdbdbd
  FontColor #0d47a1
}

' Домен «Каталог»: собственно товары, готовые сборки и склад.
package "Домен «Каталог»" #fafafa {
  class КатегорияКомпонента {
    Идентификатор
    Название
    Тип компонента
  }
  class Компонент {
    Идентификатор
    Название
    Производитель
    Цена
    Характеристики
    Описание
    Фото
    Рейтинг
  }
  class ГотоваяКонфигурация {
    Идентификатор
    Название
    Задачи
    Фото
    Стоимость
  }
  class ПозицияКонфигурации {
    Конфигурация
    Компонент
    Количество
  }
  class Остаток {
    Компонент
    Количество
    Зарезервировано
  }
}

' Домен «Совместимость»: шаги конфигуратора и правила проверки.
' Правила вынесены в справочник, чтобы одна и та же проверка
' использовалась в REST-API и в MCP-сервере.
package "Домен «Совместимость»" #fafafa {
  class ШагКонфигуратора {
    Номер
    Название
    Параметры
    Обязательный
  }
  class ПравилоСовместимости {
    Код
    Параметр
    Оператор
    Значение
    Сообщение
  }
}

' Домен «Пользователи»: учётные записи и сессии. Новое в ЛР4.
package "Домен «Пользователи»" #fafafa {
  class Роль {
    Идентификатор
    Название
  }
  class Пользователь {
    Идентификатор
    E-mail
    Хеш пароля
    Имя
    Телефон
    Роль
    Дата регистрации
  }
  class Сессия {
    Токен
    Пользователь
    Истекает
    Отозван
  }
}

' Домен «Корзина»: черновик заказа. Новое в ЛР4.
package "Домен «Корзина»" #fafafa {
  class Корзина {
    Идентификатор
    Покупатель
    Обновлена
  }
  class ПозицияКорзины {
    Корзина
    Компонент
    Количество
    Цена
  }
}

' Домен «Заказы»: подтверждённая покупка. Новое в ЛР4.
package "Домен «Заказы»" #fff8e1 {
  class Заказ {
    Идентификатор
    Номер
    Покупатель
    Статус
    Способ доставки
    Адрес
    Телефон
    Способ оплаты
    Итоговая сумма
    Создан
    Обновлён
  }
  class ПозицияЗаказа {
    Заказ
    Компонент
    Наименование (снимок)
    Цена (снимок)
    Количество
    Сумма
  }
  class Промокод {
    Код
    Тип скидки
    Значение
    Период
    Активен
  }
}

' Домен «Сборки и отзывы»: серверные конфигурации и отзывы.
package "Домен «Сборки и отзывы»" #fafafa {
  class Сборка {
    Идентификатор
    Владелец
    Название
    Стоимость
    Дата
  }
  class ПозицияСборки {
    Сборка
    Компонент
    Количество
  }
  class Отзыв {
    Автор
    Компонент
    Оценка
    Текст
    Дата
    Модерация
  }
}

' Домен «Аудит»: журнал действий MCP-агента с маскированием PII.
' Требование задания 5: «работа с конфиденциальными данными
' (требование к логированию действий агента)».
package "Домен «Аудит»" #fff8e1 {
  class ДействиеАгента {
    Момент
    Агент
    Инструмент
    Аргументы
    Результат
    Код
  }
}

' Связи между доменами. Нотация: "1" — ровно один, "0..*" —
' от нуля до многих. Подпись на связи — причина её существования.
' --- связи ---
КатегорияКомпонента "1" -- "0..*" Компонент
Компонент "1" -- "0..1" Остаток
ГотоваяКонфигурация "1" -- "1..*" ПозицияКонфигурации
Компонент "1" -- "0..*" ПозицияКонфигурации

Роль "1" -- "0..*" Пользователь
Пользователь "1" -- "0..*" Сессия
Пользователь "0..1" -- "1" Корзина
Корзина "1" -- "0..*" ПозицияКорзины
Компонент "1" -- "0..*" ПозицияКорзины

Пользователь "1" -- "0..*" Заказ
Заказ "1" -- "1..*" ПозицияЗаказа
Компонент "1" -- "0..*" ПозицияЗаказа
Заказ "0..1" -- "0..1" Промокод

Пользователь "1" -- "0..*" Сборка
Сборка "1" -- "1..*" ПозицияСборки
Компонент "1" -- "0..*" ПозицияСборки
Пользователь "1" -- "0..*" Отзыв
Компонент "1" -- "0..*" Отзыв

ШагКонфигуратора ..> ПравилоСовместимости : использует
ДействиеАгента ..> Пользователь : инициировано
@enduml