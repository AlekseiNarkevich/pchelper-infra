@startuml 01-requirements-model

' ============================================================================
'  МОДЕЛЬ ТРЕБОВАНИЙ: Действующее лицо -> User Story -> Вариант использования
'  Лабораторная работа № 4, задание 1 (соответствует рис. 1 методички).
'
'  Как читать диаграмму:
'    * левая колонка — действующие лица (акторы системы);
'    * средняя      — тексты User Stories в формате
'                     «Как <роль>, я хочу <действие>, чтобы <цель>»;
'    * правая       — варианты использования UC-01…UC-25.
'  Связи идут строго слева направо: актёр -> история -> прецедент.
'  Это обеспечивает сквозную прослеживаемость:
'  актёр -> история -> UC -> HTTP-маршрут (раздел 3.3) -> тест-кейс (4.3).
'
'  Порядок блоков в файле: Гость, Покупатель, Менеджер, AI-ассистент.
' ============================================================================
title Модель требований: Действующее лицо → User Story → Вариант использования
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam actorBackgroundColor #ffffff
skinparam actorBorderColor #1976d2
skinparam actorFontColor #0d47a1
skinparam usecaseBackgroundColor #e8e8e8
skinparam usecaseBorderColor #bdbdbd
skinparam usecaseFontColor #212121
skinparam ArrowColor #1976d2
skinparam ArrowFontColor #0d47a1
hide empty description

' ============================ ГОСТЬ ============================
actor "Гость" as G

usecase "US-01\nКак гость, я хочу\nпросматривать каталог\nкомплектующих с фильтрами,\nчтобы найти нужный товар" as S01
usecase "UC-01\nПросмотр каталога\nкомплектующих" as UC01

usecase "US-07\nКак гость, я хочу\nискать и фильтровать товары\nпо характеристикам и цене,\nчтобы сравнить варианты" as S07
usecase "UC-02\nФильтрация, сортировка\nи поиск каталога" as UC02

usecase "US-02\nКак гость, я хочу\nсобрать ПК пошагово,\nчтобы получить совместимую\nконфигурацию" as S02
usecase "UC-03\nПошаговая сборка ПК\nв конфигураторе" as UC03

usecase "US-02" as S02b
usecase "UC-04\nПроверка совместимости\nконфигурации" as UC04

usecase "US-06\nКак гость, я хочу\nузнать рекомендуемую мощность\nБП, чтобы не переплатить" as S06
usecase "UC-05\nРасчёт рекомендуемой\nмощности БП" as UC05

usecase "US-01" as S01c
usecase "UC-06\nПросмотр готовых\nконфигураций" as UC06

usecase "US-17\nКак гость, я хочу\nполучить диагностику\nнеполадок ПК" as S17
usecase "UC-07\nДиагностика\nнеполадок ПК" as UC07

G --> S01
S01 --> UC01
G --> S07
S07 --> UC02
G --> S02
S02 --> UC03
S02b --> UC04
G --> S06
S06 --> UC05
S01c --> UC06
G --> S17
S17 --> UC07

' Блок покупателя. Эта роль объединяет гостя (без авторизации) и
' зарегистрированного пользователя: набор функций у них одинаковый,
' различается только уровень аутентификации (требование FR-08).
' ============================ ПОКУПАТЕЛЬ ============================
actor "Покупатель" as C

usecase "US-08\nКак покупатель, я хочу\nзарегистрироваться и войти,\nчтобы оформить заказ" as S08
usecase "UC-08\nРегистрация\nпокупателя" as UC08

usecase "US-08" as S08b
usecase "UC-09\nАутентификация\n(вход / refresh)" as UC09

usecase "US-09\nКак покупатель, я хочу\nуправлять корзиной,\nчтобы оформить заказ в один клик" as S09
usecase "UC-10\nУправление корзиной" as UC10

usecase "US-03\nКак покупатель, я хочу\nоформить заказ из корзины,\nчтобы приобрести товары" as S03
usecase "UC-11\nОформление заказа" as UC11

usecase "US-03" as S03b
usecase "UC-12\nПросмотр истории\nзаказов" as UC12

usecase "US-10\nКак покупатель, я хочу\nотменить заказ,\nпока он не отправлен" as S10
usecase "UC-13\nОтмена заказа" as UC13

usecase "US-05\nКак покупатель, я хочу\nсохранять сборки,\nчтобы вернуться к ним позже" as S05
usecase "UC-14\nСохранение и загрузка\nсборок" as UC14

usecase "US-11\nКак покупатель, я хочу\nполучать уведомления\nо статусе заказа" as S11
usecase "UC-15\nУведомление\nо статусе заказа" as UC15

usecase "US-12\nКак покупатель, я хочу\nоставить отзыв,\nчтобы помочь другим" as S12
usecase "UC-16\nОтзыв\nо товаре" as UC16

C --> S08
S08 --> UC08
S08b --> UC09
C --> S09
S09 --> UC10
C --> S03
S03 --> UC11
S03b --> UC12
C --> S10
S10 --> UC13
C --> S05
S05 --> UC14
C --> S11
S11 --> UC15
C --> S12
S12 --> UC16

' Блок менеджера — сотрудника магазина. Управляет заказами,
' товарами, складскими остатками и аналитикой продаж.
' ============================ МЕНЕДЖЕР ============================
actor "Менеджер" as M

usecase "US-04\nКак менеджер, я хочу\nуправлять заказами,\nчтобы обрабатывать заказы покупателей" as S04
usecase "UC-17\nПросмотр списка\nзаказов" as UC17

usecase "US-04" as S04b
usecase "UC-18\nСмена статуса заказа" as UC18

usecase "US-04" as S04c
usecase "UC-19\nКомментарий\nк заказу" as UC19

usecase "US-13\nКак менеджер, я хочу\nуправлять товарами и остатками,\nчтобы поддерживать ассортимент" as S13
usecase "UC-20\nУправление товарами\nи остатками" as UC20

usecase "US-14\nКак менеджер, я хочу\nвидеть аналитику продаж,\nчтобы планировать закупки" as S14
usecase "UC-21\nАналитика продаж" as UC21

M --> S04
S04 --> UC17
S04b --> UC18
S04c --> UC19
M --> S13
S13 --> UC20
M --> S14
S14 --> UC21

' Блок AI-ассистента. Это внешний клиент системы, работающий
' по протоколу MCP; его действия реализует MCP-сервер задания 5.
' ============================ AI-АССИСТЕНТ ============================
actor "AI-ассистент\n(MCP-клиент)" as AI

usecase "US-15\nКак AI-ассистент, я хочу\nсобрать ПК под бюджет,\nчтобы помогать клиентам" as S15
usecase "UC-22\nАгентная сборка ПК\nпо бюджету" as UC22

usecase "US-15" as S15b
usecase "UC-23\nАгентная проверка\nсовместимости" as UC23

usecase "US-16\nКак AI-ассистент, я хочу\nотслеживать заказы,\nчтобы сообщать клиенту статус" as S16
usecase "UC-24\nАгентный мониторинг\nзаказов" as UC24

usecase "US-17" as S17b
usecase "UC-25\nАгентное управление\nостатками" as UC25

AI --> S15
S15 --> UC22
S15b --> UC23
AI --> S16
S16 --> UC24
AI --> S17b
S17b --> UC25
@enduml