@startuml 09-mcp-sequence

' ============================================================================
'  ПОСЛЕДОВАТЕЛЬНОСТЬ ВЗАИМОДЕЙСТВИЯ MCP
'  Лабораторная работа № 4, задание 5.
'
'  Диаграмма показывает полный агентный сценарий «Собрать ПК и оформить заказ»
'  в разрезе времённой шкалы (autonumber) и разбита на три смысловых блока:
'
'    Шаг 1. Подбор компонентов под бюджет
'           LLM сначала ЧИТАЕТ ресурсы (правила совместимости, каталог),
'           затем ВЫЗЫВАЕТ инструменты поиска и проверки.
'    Шаг 2. Оформление заказа
'           Сервер повторно проверяет совместимость, списывает остатки
'           и фиксирует снимок цен в одной транзакции.
'    Шаг 3. Отслеживание и защита от неверных действий
'           Показана отказная ветка: отмена отправленного заказа запрещена.
'
'  Обозначения: сплошная стрелка — вызов, пунктир с «<<…>>» — чтение ресурса
'  или возврат значения.
' ============================================================================
title MCP — последовательность взаимодействия при сценарии «Собрать ПК и оформить заказ»
skinparam shadowing false
skinparam sequenceParticipantBorderColor #bdbdbd
skinparam sequenceParticipantBackgroundColor #fafafa
skinparam sequenceArrowColor #1976d2
skinparam sequenceLifeLineBorderColor #1976d2
autonumber

actor "Покупатель" as U
participant "Claude Desktop\n(MCP-клиент)" as L
participant "LLM" as M
participant "MCP-сервер\n(FastMCP)" as S
' Участники слева направо: пользователь, MCP-хост, сама модель LLM,
' MCP-сервер и mock-база. LLM показан отдельно от хоста намеренно:
' решение о вызове инструмента принимает модель, а не клиент.
participant "SQLite\n(pchelper_mcp.db)" as DB

' ----------------------------------------------------------------------------
' ШАГ 1. ПОДБОР. Порядок принципиален: сначала читаются правила,
' и только потом подбираются компоненты — иначе LLM не знает,
' какие ограничения действуют.
== Шаг 1. Подбор компонентов под бюджет ==
U -> L : «Собери игровой ПК до 4000 BYN»
L -> M : запрос + список доступных примитивов
M -> S : resources/list
S --> M : 9 ресурсов (catalog, orders, promo, audit…)
M -> S : resources/read pchelper://catalog/cpu
S -> DB : SELECT * FROM Компоненты_…
DB --> S : строки каталога
S --> M : JSON с ассортиментом и ценами
M -> S : tools/call search_components\n(type=gpu, max_price=1500)
S -> DB : SELECT … WHERE цена <= 1500
S --> M : 5 видеокарт
M -> S : tools/call check_compatibility\n(cpu_id, mobo_id, ram_id, cooling_id,\ngpu_id, storage_ids, psu_id, case_id)
S -> S : прогон 8 правил совместимости
S --> M : {compatible: true, errors: [], warnings: [«запас БП 27 %»]}
M -> L : текстовый отчёт + ссылка на конфигуратор
L -> U : «Вот сборка за 3 780 BYN»

' ----------------------------------------------------------------------------
' ШАГ 2. ЗАКАЗ. Повторная серверная проверка совместимости нужна
' потому, что клиент мог изменить состав корзины после проверки.
== Шаг 2. Оформление заказа ==
U -> L : «Добавь в корзину и оформи заказ»
M -> S : tools/call add_to_cart(user_id, gpu_id, 1)
S -> DB : INSERT INTO Корзина_Позиции
M -> S : tools/call create_order(user_id, delivery, payment_method)
S -> S : 1) повторная проверка совместимости\n2) списание остатков\n3) снимок цен
S -> DB : BEGIN … INSERT INTO Заказы … COMMIT
S --> M : {order_id: 1042, номер: «PCH-2026-1042», итог: 3780}
M -> L : подтверждение
L -> U : «Заказ PCH-2026-1042 оформлен»

' ----------------------------------------------------------------------------
' ШАГ 3. ОТСЛЕЖИВАНИЕ И ЗАЩИТА. Показывает, что ресурс читается
' до вызова инструмента и что запрещённое действие отклоняется
' сервером, а не «молча» игнорируется.
== Шаг 3. Отслеживание и защита от неверных действий ==
U -> L : «Где мой заказ?»
M -> S : resources/read pchelper://orders/recent
S --> M : [{order_id: 1042, tracking_number: «BY-7744123», статус: «В обработке»}]
M -> S : tools/call track_order(order_id=1042, tracking_number=«BY-7744123»)
S -> S : сверка tracking_number с БД
S --> M : {статус: «В обработке», eta: «14 окт»}
L -> U : «Ваш заказ в обработке, трек BY-7744123»

U -> L : «Отмени заказ»
M -> S : tools/call cancel_order(order_id=1042, reason=«передумал»)
S -> S : проверка статусной машины\n«Отправлен» → CANCEL запрещён
S --> M : isError: true, «Заказ уже отправлен, отмена недоступна.\nОбратитесь в поддержку.»
L -> U : «Отменить нельзя — заказ уже отправлен»

' ----------------------------------------------------------------------------
' АУДИТ. Каждый вызов инструмента пишется в таблицу
' «ЖурналДействийАгента» с маскированием персональных данных.
== Аудит ==
S -> DB : INSERT INTO ЖурналДействийАгента\n(tool, args, result, код)
@enduml