# =====================================================================
#  Контекст сборки образа backend (ЛР4).
#  node_modules не нужно копировать в образ: Dockerfile выполняет
#  `npm ci` заново. Исключаем его, чтобы не раздувать контекст сборки
#  и не тянуть в образ хостовые зависимости.
# =====================================================================

node_modules
npm-debug.log*

# Артефакты локальных сборок и отчёты покрытия
dist
build
coverage
.cache

# Локальное окружение и служебные файлы
.env
.env.local
.vscode
.idea
.DS_Store
Thumbs.db