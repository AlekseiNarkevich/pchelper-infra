{
  "name": "pchelper-infra-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PCHelper — backend интернет-магазина комплектующих (ЛР7)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/health.test.js tests/catalog.test.js",
    "test:smoke": "node --test tests/smoke.test.js",
    "test:ci": "node --test tests/health.test.js tests/catalog.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 70 node --test tests/health.test.js tests/catalog.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
