{
  "name": "pchelper-infra-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Минимальный backend для инфраструктуры ЛР4 (задание 6). Не является частью курсовой работы.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/health.test.js",
    "test:smoke": "node --test tests/smoke.test.js",
    "test:ci": "node --test tests/health.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test tests/health.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
