# =====================================================================
#  PCHelper (ЛР4) — файлы, которые НЕ коммитятся в git
# =====================================================================

# --- Переменные окружения: содержат пароли, в репозиторий не попадают ---
.env
.env.local

# --- Зависимости npm (восстанавливаются через npm ci) ---
node_modules/
npm-debug.log*

# --- Собранная статика и артефакты сборки ---
dist/
build/
.cache/

# --- Отчёты о покрытии кода ---
coverage/
*.lcov

# --- Сгенерированная спецификация API (собирается на этапе CI) ---
api/dist/

# --- Локальная mock-база MCP-сервера ---
pchelper_mcp.db
*.db-journal

# --- Python: кэш и виртуальное окружение MCP-сервера ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Служебные файлы ОС и редакторов ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp