# =====================================================================
#  PCHelper — контейнер MCP-сервера
#  Лабораторная работа № 4, задание 5 (серверная часть) и задание 6,
#  пункт 8 (конфигурация контейнеров).
#
#  Собирается из каталога mcp/ командой:
#      docker compose --profile mcp build mcp
#
#  Сервер слушает Streamable HTTP на порту 8080,
#  подключается к mock-базе SQLite и запускает MCP Inspector.
#
#  Версии зависимостей закреплены точно: без этого сборка не
#  воспроизводима, а SonarCloud помечает установку как
#  небезопасную (правила S8541 и S8544).
# =====================================================================

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PCHELPER_AGENT_NAME=docker

# --- Непривилегированный пользователь и каталог данных -----------
# Создание пользователя и каталога объединено в одну инструкцию:
# раздельные RUN заставляют пересоздавать слой файловой системы
# дважды (SonarCloud S7031).
#
# Каталог /data объявлен томом и передаётся пользователю mcp,
# поэтому база SQLite остаётся доступной после смены слоя.
RUN useradd --no-create-home --shell /usr/sbin/nologin mcp \
    && mkdir -p /data \
    && chown mcp:mcp /data

VOLUME ["/data"]
ENV PCHELPER_DB=/data/pchelper_mcp.db

# --- Зависимости ----------------------------------------------------
# Устанавливаются от root: non-root пользователь ещё не может
# писать в системные каталоги. Сами файлы и база не содержат
# пользовательских данных.
#
# Ставится ТОЛЬКО РАНТАЙМ - файл requirements.lock собран без
# тестовых пакетов. pytest в рабочем образе не нужен: ни конвейер,
# ни docker compose не прогоняют тесты внутри контейнера, а вместе
# с pytest в образ попадала уязвимость CVE-2025-71176.
# Для локального запуска тестов используйте requirements.txt.
#
# --require-hashes + файл requirements.lock: pip сверяет хеш каждого
# пакета и откажется ставить тот, чей хеш не совпал. Без этого
# подменённый на сервере пакет установился бы молча (SonarCloud S8544).
# --only-binary :all: запрещает выполнение setup-скриптов из пакетов
# во время установки (SonarCloud S8541).
COPY requirements.lock ./
RUN pip install --no-cache-dir --only-binary :all: \
    --require-hashes -r requirements.lock

# --- Код сервера ----------------------------------------------------
# Файлы копируются от root и остаются доступными пользователю mcp
# только на чтение: --chown=mcp:mcp дал бы ему право их менять,
# а это лишний вектор атаки (SonarCloud S6470).
# Файлы перечислены явно, а не копируются рекурсивно: так в образ
# не могут случайно попасть артефакты локальной разработки.
COPY audit.py db.py healthcheck.py \
     schema.sql seed.sql server.py services.py ./

USER mcp

EXPOSE 8080

# Healthcheck: стандартный urllib отвечает HTTP-ошибкой на GET /mcp
# (406 Not Acceptable - это ожидаемый ответ при инициации MCP).
# Для проверки написан отдельный healthcheck.py, использующий
# транспорт, который применяет сам MCP-клиент.
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD ["python", "healthcheck.py"]

# --http — это режим Streamable HTTP; без --http сервер работает
# в режиме stdio. 0.0.0.0 — чтобы контейнер был доступен извне,
# 127.0.0.1 — только изнутри контейнера.
CMD ["python", "server.py", "--http", "--host", "0.0.0.0", "--port", "8080"]