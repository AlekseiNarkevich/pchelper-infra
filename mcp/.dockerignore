# =====================================================================
#  Контекст сборки образа MCP-сервера.
#  Исключаем всё, что не нужно внутри контейнера: ускоряет сборку
#  и не даёт случайно упаковать локальное виртуальное окружение.
# =====================================================================

# Локальная mock-база — в контейнере создаётся заново из schema.sql и seed.sql
*.db
*.db-journal

# Виртуальное окружение и кэш Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Локальные файлы редактора и ОС
.vscode/
.idea/
.DS_Store
Thumbs.db

# Временные файлы проверок (результаты прогона тестов)
tests/__pycache__/